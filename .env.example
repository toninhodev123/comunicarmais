# Copie este arquivo para .env.local e preencha com os valores do painel:
# https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (admin) do Supabase — NUNCA usar com prefixo VITE_ e nunca
# importar de código que roda no navegador. Só é necessária se algum dia
# um script/rota server-side precisar de acesso privilegiado ao banco.
SUPABASE_SECRET_KEY=

# Só para gravar os áudios do app na sua máquina (`bun run audio --
# --provedor=elevenlabs`). Nunca é lida pelo site publicado — o que vai para
# produção são os mp3 em public/audio.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
