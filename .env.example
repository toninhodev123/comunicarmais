# Copie este arquivo para .env.local e preencha com os valores do painel:
# https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (admin) do Supabase — NUNCA usar com prefixo VITE_ e nunca
# importar de código que roda no navegador. Só é necessária se algum dia
# um script/rota server-side precisar de acesso privilegiado ao banco.
SUPABASE_SECRET_KEY=
